{
  "plugins": ["unicorn", "typescript", "react", "react-hooks"],
  "jsPlugins": ["oxlint-plugin-eslint"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "no-unused-vars": "error",
    "eslint-js/id-length": [
      "error",
      {
        "min": 2,
        "exceptions": ["i"]
      }
    ],
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-ternary": "warn",
    "@typescript-eslint/consistent-type-imports": "error",
    "react/jsx-no-target-blank": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "JSXOpeningElement[name.name='svg']",
        "message": "Inline <svg> elements are not allowed. Define icon components in src/components/icons/ and import them."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/icons/**"],
      "rules": {
        "eslint-js/no-restricted-syntax": "off"
      }
    }
  ]
}
