# Copy to `api/.env` and fill in values. Docker Compose loads `api/.env` automatically.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=demand_letters
DB_USER=dev_user
DB_PASSWORD=dev_password

# AWS — use explicit keys for local dev, or omit both to use the default credential chain
AWS_REGION=us-east-2
AWS_S3_BUCKET_DOCUMENTS=
AWS_S3_BUCKET_EXPORTS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=

# Comma-separated origins. Use * for wildcard (expanded to localhost dev ports in main.py).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
